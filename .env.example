# Primary AI Configuration
PRIMARY_AI_API_KEY="YOUR_PRIMARY_API_KEY_HERE"
PRIMARY_AI_BASE_URL="https://api.openai.com/v1"
PRIMARY_AI_MODEL="openai/gpt-oss-20b"

# Secondary (Fallback) AI Configuration
SECONDARY_AI_API_KEY="your_groq_api_key_here"
SECONDARY_AI_BASE_URL="https://api.groq.com/openai/v1"
SECONDARY_AI_MODEL="openai/gpt-oss-120b"

# Specialized AI Models
VISION_AI_MODEL="qwen/qwen3.6-27b"
MULTILINGUAL_AI_MODEL="llama-3.3-70b-versatile"

# AI Fallback Key Pool (To handle rate limits)
GROQ_FALLBACK_KEY_1="YOUR_GROQ_FALLBACK_KEY_1"
GROQ_FALLBACK_KEY_2="YOUR_GROQ_FALLBACK_KEY_2"
GROQ_FALLBACK_KEY_3="YOUR_GROQ_FALLBACK_KEY_3"
GROQ_FALLBACK_KEY_4="YOUR_GROQ_FALLBACK_KEY_4"
GROQ_FALLBACK_KEY_5="YOUR_GROQ_FALLBACK_KEY_5"
GROQ_FALLBACK_KEY_6="YOUR_GROQ_FALLBACK_KEY_6"
GROQ_FALLBACK_KEY_7="YOUR_GROQ_FALLBACK_KEY_7"
GROQ_FALLBACK_KEY_8="YOUR_GROQ_FALLBACK_KEY_8"
GROQ_FALLBACK_KEY_9="YOUR_GROQ_FALLBACK_KEY_9"
GROQ_FALLBACK_KEY_10="YOUR_GROQ_FALLBACK_KEY_10"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Clerk Auth: Required for User Authentication
VITE_CLERK_PUBLISHABLE_KEY="YOUR_CLERK_PUBLISHABLE_KEY_HERE"

# Supabase Backend Access
SUPABASE_URL="YOUR_SUPABASE_URL_HERE"
SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY_HERE"
SUPABASE_SERVICE_ROLE_KEY="YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE"

# Admin Secret
ADMIN_SECRET="your_admin_secret_here"

# Razorpay Configuration
RAZORPAY_KEY_ID="rzp_test_YourKeyIdHere"
RAZORPAY_KEY_SECRET="YourRazorpaySecretHere"
